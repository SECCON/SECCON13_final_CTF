#!/usr/bin/env python3
import json
import hashlib
import os
import random
import subprocess
import sys

def gen_input(tick: int):
    """tickに基づいてランダムな入力を作る
    """
    if tick <= 12:
        # 0-60分
        n = random.randint(100, 150)
        A = [random.randint(0, 100) for _ in range(n*n)]
        B = [random.randint(0, 100) for _ in range(n*n)]
        return map(str, [n] + A + B)

    elif tick <= 18:
        # 60-90分
        n = random.randint(150, 500)
        A = [random.randint(-100, 100) for _ in range(n*n)]
        B = [random.randint(-100, 100) for _ in range(n*n)]
        return map(str, [n] + A + B)

    elif tick <= 24:
        # 90-120分
        n = random.randint(400, 700)
        A = [random.randint(-10, 10) for _ in range(n*n)]
        B = [random.randint(-10, 10) for _ in range(n*n)]
        return map(str, [n] + A + B)

    else:
        # 120-180分
        n = random.randint(700, 800)
        A = [random.randint(-10, 10) for _ in range(n*n)]
        B = [random.randint(-10, 10) for _ in range(n*n)]
        return map(str, [n] + A + B)

if __name__ == '__main__':
    dirpath = os.path.dirname(os.path.abspath(sys.argv[0]))
    solver_path = os.path.join(dirpath, '../build/ans-5')
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} tick")
        exit(1)

    tick = int(sys.argv[1])

    inp = ' '.join(gen_input(tick)).encode()
    try:
        p = subprocess.Popen(
            [solver_path], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
        o = p.communicate(inp, timeout=10)
        print(json.dumps({'input': inp.hex(), 'output': o[0].hex()}))

    except subprocess.TimeoutExpired as e:
        pass

    finally:
        p.kill()
