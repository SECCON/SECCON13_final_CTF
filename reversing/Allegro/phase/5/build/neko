#!/usr/bin/env python3
import json
import hashlib
import os
import random
import subprocess
import sys

def gen_input(tick: int):
    """tickに基づいてランダムな入力を作る
    """
    n = 200
    A = [1 for _ in range(n*n)]
    B = [-1 for _ in range(n*n)]
    return map(str, [n] + A + B)

if __name__ == '__main__':
    dirpath = os.path.dirname(os.path.abspath(sys.argv[0]))
    solver_path = os.path.join(dirpath, '../build/ans-5')
    inp = ' '.join(gen_input(0)).encode()
    try:
        p = subprocess.Popen(
            [solver_path], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
        o = p.communicate(inp, timeout=10)
        print(o[0])
        #print(json.dumps({'input': inp.hex(), 'output': o[0].hex()}))

    except subprocess.TimeoutExpired as e:
        pass

    finally:
        p.kill()
