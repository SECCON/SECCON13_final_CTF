<!DOCTYPE html>
<html>
<head>
    <title>Auth Server - Home</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 0;
        }
        .container {
            width: 100%;
            max-width: 600px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .content {
            background: white;
            padding: 2.5rem;
            border-radius: 10px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            text-align: center;
            width: 100%;
            max-width: 400px;
        }
        h1 {
            text-align: center;
            color: #2d3748;
            margin-bottom: 1.5rem;
            font-size: 2rem;
        }
        p {
            color: #4a5568;
            margin-bottom: 1rem;
        }
        a {
            display: inline-block;
            padding: 12px 25px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin: 0 10px;
            transition: background-color 0.3s ease;
        }
        a:hover {
            background: #5a67d8;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="content">
            <h1>Welcome to Auth Server</h1>
            <% if (user) { %>
                <p>Logged in as: <%= user.username %></p>
                <p><a href="https://<%= process.env.APP_HOSTNAME %>" id="go-app">Go to App</a></p>
            <% } else { %>
                <p><a href="/login">Login</a> <a href="/register">Register</a></p>
            <% } %>
        </div>
    </div>
</body>
</html>
